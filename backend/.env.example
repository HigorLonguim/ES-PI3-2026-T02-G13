# Porta do servidor
PORT=3000

# Origens permitidas no CORS (separadas por virgula)
# Exemplo: CORS_ALLOWED_ORIGINS=http://localhost:8080,https://app.mesclainvest.com.br
CORS_ALLOWED_ORIGINS=

# Permite localhost/127.0.0.1 automaticamente em desenvolvimento (true/false)
CORS_ALLOW_LOCALHOST=true

# Firebase Admin SDK - Service Account
FIREBASE_PROJECT_ID=seu-project-id-aqui
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END RSA PRIVATE KEY-----\n"
