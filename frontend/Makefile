# Makefile for MesclaInvest Frontend
# Autoria: Felipe Sousa - RA: 22018160

.PHONY: run-debug run help

help:
	@echo "Comandos disponíveis:"
	@echo "  make run-debug    - Executa o app com DEBUG_MODE=true (Navigator de Debug ativo)"
	@echo "  make run          - Executa o app normalmente"

run-debug:
	flutter run --dart-define-from-file=.env

run:
	flutter run
