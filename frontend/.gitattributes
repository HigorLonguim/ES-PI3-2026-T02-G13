# Mantem consistencia de fim de linha dentro do app Flutter.
* text=auto

# Scripts Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Scripts Unix.
*.sh text eol=lf

# Fontes e configs comuns do frontend.
*.dart text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.swift text eol=lf
*.cmake text eol=lf
*.cc text eol=lf

# Arquivos gerados do Flutter que sofriam ruido de line ending.
**/generated_plugin_registrant.cc text eol=lf
**/generated_plugins.cmake text eol=lf
macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf