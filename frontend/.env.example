# Autoria: Felipe Sousa - RA: 22018160

# URL base do backend REST usado como fallback para login e recuperacao de senha.
API_URL=10.0.2.2:8080

# URL HTTP completa da Cloud Function usada no cadastro.
REGISTER_FUNCTION_URL=

# Chave Web API do Firebase usada para login e recuperacao diretos no Firebase Auth.
# Quando preenchida, o frontend prioriza Firebase Auth direto.
FIREBASE_WEB_API_KEY=

# Opcional: habilita o fluxo mock de recuperacao de senha.
RECOVER_PASSWORD_USE_MOCK=false

# Opcional: exibe o menu de debug quando true.
DEBUG_MODE=false

# Ajustes de IP por plataforma para os alvos do Makefile.
ANDROID_EMULATOR_IP=10.0.2.2
IOS_SIMULATOR_IP=127.0.0.1
MACOS_IP=127.0.0.1
DEVICE_IP=192.168.0.10
